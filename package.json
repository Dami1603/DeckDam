{
  "name": "deckdam",
  "version": "0.1.0",
  "private": true,
  "description": "Search a Pokémon TCG card and find out which competitive decks it fits (Limitless, City League JP, Pokecabook, Pokedata).",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scrape": "node scraper/index.js",
    "scrape:limitless": "node scraper/index.js --only=limitless",
    "scrape:pokecabook": "node scraper/index.js --only=pokecabook",
    "scrape:limitless-jp": "node scraper/index.js --only=limitless-jp",
    "scrape:pokedata": "node scraper/index.js --only=pokedata",
    "scrape:expanded": "node scraper/index.js --only=pokecabook-expanded"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "cheerio": "^1.2.0",
    "express": "^4.22.3"
  },
  "homepage": "https://deckdam.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dami1603/DeckDam.git"
  },
  "license": "UNLICENSED"
}
